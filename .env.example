# .env.example
# Copy this file to .env and edit values as needed.
# Only override what you need - services have sensible defaults.

# =============================================================================
# SECRETS & TOKENS
# =============================================================================

# Hugging Face token (for model downloads): https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token-here

# JWT secret key - generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production

# =============================================================================
# LLM PROVIDER
# =============================================================================

# Options: "vllm" (local), "gemini" (Google), "mistral" (Mistral AI)
LLM_PROVIDER=mistral

# Gemini (if LLM_PROVIDER=gemini): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemma-3-27b-it

# Mistral (if LLM_PROVIDER=mistral): https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-small-latest

# vLLM (if LLM_PROVIDER=vllm)
# VLLM_HOST=localhost
# VLLM_MAIN_PORT=8000
# MODEL_PATH=/models/Qwen--Qwen2.5-1.5B-Instruct

# =============================================================================
# MONGODB
# =============================================================================

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=example
MONGO_INITDB_DATABASE=guia_docente

# Mongo Express UI credentials
MONGO_EXPRESS_BASICAUTH_USERNAME=admin
MONGO_EXPRESS_BASICAUTH_PASSWORD=adminpassword

# =============================================================================
# MATH SERVICE
# =============================================================================

# Math service URL (usually don't need to change for Docker)
# MATH_SERVICE_URL=http://math_service:8083

# Enable/disable Phoenix tracing
PHOENIX_ENABLED=true

# Phoenix service connection (usually don't need to change for Docker)
PHOENIX_HOST=phoenix
PHOENIX_PORT=6006
PHOENIX_PROJECT_NAME=tfg-chatbot