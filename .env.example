# .env.example
# Copy this file to .env and edit values as needed.

# =============================================================================
# GENERAL
# =============================================================================

# If set to "true" the Docker build will install optional dev dependencies
INSTALL_DEV=false

# =============================================================================
# AUTHENTICATION (Backend Gateway)
# =============================================================================

# IMPORTANT: Generate a secure key for production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# LLM PROVIDER (Chatbot Service)
# =============================================================================

# Choose between "vllm" (local inference) or "gemini" (Google Gemini)
LLM_PROVIDER=gemini

# vLLM Configuration (only needed if LLM_PROVIDER=vllm)
# VLLM_HOST=vllm-openai
# VLLM_MAIN_PORT=8000
# MODEL_PATH=/models/HuggingFaceTB--SmolLM2-1.7B-Instruct

# Google Gemini Configuration (only needed if LLM_PROVIDER=gemini)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# =============================================================================
# MONGODB
# =============================================================================

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=example
MONGO_INITDB_DATABASE=tfg_chatbot

# Connection settings (used by services)
MONGO_HOSTNAME=mongo
MONGO_PORT=27017
MONGO_AUTH_DB=admin

# Mongo Express UI (optional)
MONGO_EXPRESS_BASICAUTH_ENABLED=true
MONGO_EXPRESS_BASICAUTH_USERNAME=admin
MONGO_EXPRESS_BASICAUTH_PASSWORD=adminpassword
MONGO_EXPRESS_BASEURL=/

# =============================================================================
# RAG SERVICE
# =============================================================================

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=academic_documents

# Ollama Embeddings
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=nomic-embed-text

# RAG Parameters
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# =============================================================================
# SERVICE URLs (usually don't need to change for Docker)
# =============================================================================

# CHATBOT_SERVICE_URL=http://chatbot:8080
# RAG_SERVICE_URL=http://rag_service:8081

# =============================================================================
# FRONTEND
# =============================================================================

# VITE_API_URL=/api

# =============================================================================
# OPTIONAL: HuggingFace Token (for private models)
# =============================================================================

# HF_TOKEN=your-huggingface-token-here
