{
  "openapi": "3.1.0",
  "info": {
    "title": "TFG Chatbot AI Agent API",
    "description": "AI Agent service powered by LangGraph. Handles conversation flow, tool execution, and test session management.",
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "General"
        ],
        "summary": "API Information",
        "description": "Returns information about the TFG Chatbot API including version, available endpoints, and documentation links",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful response with API information",
            "content": {
              "application/json": {
                "schema": {},
                "example": {
                  "name": "TFG Chatbot API",
                  "version": "0.1.0",
                  "description": "API for interacting with an intelligent chatbot powered by GraphAgent",
                  "endpoints": {
                    "health": "/health",
                    "chat": "/chat",
                    "docs": "/docs",
                    "redoc": "/redoc"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "General"
        ],
        "summary": "Health check",
        "description": "Check if the API is running and healthy",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "API is healthy and running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "message": "Hello World"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "tags": [
          "Chatbot"
        ],
        "summary": "Chat with the bot",
        "description": "Send a message to the chatbot and receive an intelligent response powered by GraphAgent. May return an interrupt if the bot is waiting for user input (e.g., during a test session).",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful chatbot response. Check 'interrupted' field to see if waiting for user input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error - invalid request format"
          }
        }
      }
    },
    "/resume_chat": {
      "post": {
        "tags": [
          "Chatbot"
        ],
        "summary": "Resume an interrupted test session",
        "description": "Resume a test session that was interrupted waiting for user input. Provide the user's answer to continue.",
        "operationId": "resume_chat_resume_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful resume. May return another interrupt if there are more questions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error - invalid request format"
          }
        }
      }
    },
    "/history/{session_id}": {
      "get": {
        "tags": [
          "Chatbot"
        ],
        "summary": "Get conversation history",
        "description": "Retrieve the message history for a specific conversation session.",
        "operationId": "get_history_history__session_id__get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation history retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "404": {
            "description": "No history found for this session"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scrape_guia": {
      "post": {
        "tags": [
          "Tools"
        ],
        "summary": "Scrape a guia_docente HTML and index it into MongoDB",
        "description": "Parse a UGR teaching guide HTML and store it in MongoDB.\n\nThis endpoint processes the HTML content of a teaching guide (guía docente)\nfrom the University of Granada, extracts structured information, and stores\nit in MongoDB for quick retrieval by the chatbot.\n\nThe scraper extracts:\n- Course information (name, code, credits)\n- Competencies and learning objectives\n- Course content and topics\n- Teaching methodology\n- Evaluation criteria\n- Bibliography\n\nArgs:\n    req: ScrapeRequest with HTML content, optional URL, and subject override\n\nReturns:\n    ScrapeResponse with status, subject, and MongoDB upsert result\n\nRaises:\n    ValueError: If no subject can be determined from the HTML or override\n\nExample:\n    Request:\n    {\n        \"html_content\": \"<html>...</html>\",\n        \"url\": \"https://...\",\n        \"subject_override\": \"infraestructura-virtual\"\n    }\n\n    Response:\n    {\n        \"status\": \"ok\",\n        \"subject\": \"infraestructura-virtual\",\n        \"upserted_id\": \"507f1f77bcf86cd799439011\",\n        \"detail\": {...}\n    }",
        "operationId": "scrape_guia_scrape_guia_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScrapeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScrapeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatMessage": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Message type: 'ai', 'human', 'tool', 'system'"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "The message content"
          }
        },
        "type": "object",
        "required": [
          "type",
          "content"
        ],
        "title": "ChatMessage",
        "description": "A single message in the conversation.",
        "example": {
          "content": "Hello! How can I help you?",
          "type": "ai"
        }
      },
      "ChatRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "The user's message to send to the chatbot",
            "example": "¿Qué es la inteligencia artificial?"
          },
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique session identifier for the chatbot conversation",
            "example": "user-session-123"
          },
          "asignatura": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asignatura",
            "description": "Asignatura (subject) to bind to the agent state",
            "example": "IV"
          }
        },
        "type": "object",
        "required": [
          "query",
          "id"
        ],
        "title": "ChatRequest",
        "example": {
          "asignatura": "Guía docente de Trabajo Fin de Grado (Ingeniería Informática) (2971197)",
          "id": "session-abc-123",
          "query": "¿Cómo funciona el aprendizaje automático?"
        }
      },
      "ChatResponse": {
        "properties": {
          "message": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChatMessage"
              },
              {
                "type": "null"
              }
            ],
            "description": "The assistant's response message"
          },
          "interrupted": {
            "type": "boolean",
            "title": "Interrupted",
            "description": "Whether the conversation was interrupted (waiting for user input)",
            "default": false
          },
          "interrupt_info": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InterruptInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "Information about the interrupt, if interrupted=True"
          }
        },
        "type": "object",
        "title": "ChatResponse",
        "description": "Response for chat endpoints - returns only the last assistant message.",
        "example": {
          "interrupt_info": {
            "action": "answer_question",
            "question_num": 1,
            "question_text": "¿Qué es un bucle for en Python?",
            "total_questions": 5
          },
          "interrupted": true,
          "message": {
            "content": "📝 Pregunta 1/5\n\n¿Qué es un bucle for en Python?",
            "type": "ai"
          }
        }
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryResponse": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "Messages",
            "description": "All messages in the conversation"
          }
        },
        "type": "object",
        "title": "HistoryResponse",
        "description": "Response for history endpoint - returns all messages.",
        "example": {
          "messages": [
            {
              "content": "¿Qué es Docker?",
              "type": "human"
            },
            {
              "content": "Docker es una plataforma de contenedores...",
              "type": "ai"
            }
          ]
        }
      },
      "InterruptInfo": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action",
            "description": "Type of action that caused the interrupt",
            "example": "answer_question"
          },
          "question_num": {
            "type": "integer",
            "title": "Question Num",
            "description": "Current question number (1-indexed)",
            "example": 1
          },
          "total_questions": {
            "type": "integer",
            "title": "Total Questions",
            "description": "Total number of questions in the test",
            "example": 5
          },
          "question_text": {
            "type": "string",
            "title": "Question Text",
            "description": "Text of the current question",
            "example": "¿Qué es un bucle for en Python?"
          }
        },
        "type": "object",
        "required": [
          "action",
          "question_num",
          "total_questions",
          "question_text"
        ],
        "title": "InterruptInfo",
        "description": "Information about an interrupted test session.",
        "example": {
          "action": "answer_question",
          "question_num": 1,
          "question_text": "¿Qué es un bucle for en Python?",
          "total_questions": 5
        }
      },
      "MessageResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Response message from the API",
            "example": "Hello World"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "MessageResponse",
        "example": {
          "message": "Hello World"
        }
      },
      "ResumeRequest": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Thread ID of the interrupted conversation",
            "example": "user-session-123"
          },
          "user_response": {
            "type": "string",
            "title": "User Response",
            "description": "User's answer to the current question",
            "example": "Un bucle for se utiliza para iterar sobre secuencias"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_response"
        ],
        "title": "ResumeRequest",
        "description": "Request to resume an interrupted test session.",
        "example": {
          "id": "session-abc-123",
          "user_response": "Un bucle for se utiliza para iterar sobre secuencias de elementos"
        }
      },
      "ScrapeRequest": {
        "properties": {
          "html_content": {
            "type": "string",
            "title": "Html Content",
            "description": "Raw HTML content of the guia (string)"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url",
            "description": "Optional original URL for the guia"
          },
          "subject_override": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject Override",
            "description": "If provided, will be used as the subject key stored in DB"
          }
        },
        "type": "object",
        "required": [
          "html_content"
        ],
        "title": "ScrapeRequest",
        "description": "Request body for scraping and indexing a `guia_docente`.\n\nhtml_content: the raw HTML of the guia\nurl: optional original URL\nsubject_override: optional field to force the subject value used as unique key"
      },
      "ScrapeResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "ok or error"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject",
            "description": "Subject/key used to index the document"
          },
          "upserted_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upserted Id",
            "description": "Upserted id returned by MongoDB (if any)"
          },
          "detail": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail",
            "description": "Detailed result from the upsert operation"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ScrapeResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}